{
  "name": "hello-collab-v2-tab-msgext",
  "version": "2.0.0",
  "description": "HelloCollab V2: Teams Tab + Message Extension Application",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
