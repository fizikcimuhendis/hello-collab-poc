# HelloCollab V3 Environment Variables (Enterprise - Least Privilege)
NODE_ENV=development
PORT=3000

# Azure/Teams Configuration
CLIENT_ID=your-app-id-here
CLIENT_SECRET=your-app-secret-here
TENANT_ID=your-tenant-id-here
BOT_ID=your-bot-id-here
BOT_PASSWORD=your-bot-password-here
TEAMS_APP_ID=your-teams-app-id-here

# Graph API Configuration (Least Privilege Scopes)
# NOTE: In production, these should be stored in Azure Key Vault
GRAPH_SCOPES=User.Read Calendars.ReadWrite ChannelMessage.Send
GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0

# Security Configuration
LOG_LEVEL=info
REQUEST_LOG_LEVEL=debug
ENABLE_AUDIT_LOG=true
